# 应用密钥：生产环境请改成随机字符串，至少 32 字节
SECRET_KEY=your-secret-key-change-in-production

# JWT 算法
ALGORITHM=HS256

# Token 过期时间（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Apple Sign In 的 Bundle ID
APPLE_CLIENT_ID=

# MySQL 数据库连接
# 请确保先运行 docker compose up -d mysql
DATABASE_URL=mysql+pymysql://widgets_user:widgets_password@127.0.0.1:3306/widgets_studio

# MySQL Docker 容器配置（仅用于 docker-compose.yml）
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=widgets_studio
MYSQL_USER=widgets_user
MYSQL_PASSWORD=widgets_password
